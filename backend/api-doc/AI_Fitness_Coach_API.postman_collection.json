{
  "info": {
    "name": "AI Fitness Coach API",
    "description": "Complete API collection for the AI Fitness Coach backend featuring workout generation, nutrition planning, progress tracking, and AI-powered features.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Get Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check if the API is running and all dependencies are available"
          }
        }
      ]
    },
    {
      "name": "Core Fitness Features",
      "item": [
        {
          "name": "Generate Workout Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 70.5,\n  \"height\": 175,\n  \"gender\": 1,\n  \"age\": 30,\n  \"hypertension\": \"no\",\n  \"diabetes\": \"no\",\n  \"fitness_goal\": \"build muscle\",\n  \"workout_preference\": \"strength training\",\n  \"workout_location\": \"gym\",\n  \"duration\": \"45 minutes\",\n  \"experience_level\": \"intermediate\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/generate-workout",
              "host": ["{{base_url}}"],
              "path": ["generate-workout"]
            },
            "description": "Generate a personalized workout plan based on user profile and preferences"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.session_id) {",
                  "        pm.collectionVariables.set('session_id', response.session_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate Nutrition Plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 70.5,\n  \"height\": 175,\n  \"gender\": 1,\n  \"age\": 30,\n  \"hypertension\": \"no\",\n  \"diabetes\": \"no\",\n  \"fitness_goal\": \"build muscle\",\n  \"workout_preference\": \"strength training\",\n  \"workout_location\": \"gym\",\n  \"duration\": \"45 minutes\",\n  \"experience_level\": \"intermediate\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/generate-nutrition",
              "host": ["{{base_url}}"],
              "path": ["generate-nutrition"]
            },
            "description": "Generate a personalized nutrition plan based on user profile"
          }
        },
        {
          "name": "Handle User Concerns",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"concern\": \"I'm feeling sore after yesterday's workout\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/user-concerns/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["user-concerns", "{{session_id}}"]
            },
            "description": "Address user concerns and provide personalized advice"
          }
        }
      ]
    },
    {
      "name": "Session Management",
