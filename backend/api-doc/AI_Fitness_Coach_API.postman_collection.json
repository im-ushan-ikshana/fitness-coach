        {
          "name": "Get Session Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/session/{{session_id}}",
              "host": ["{{base_url}}"],
              "path": ["session", "{{session_id}}"]
