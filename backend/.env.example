# AI Fitness Coach Backend Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# OPENAI API CONFIGURATION
# =============================================================================

# OpenAI API Key - Required for AI-powered workout generation and chat features
# Get your API key from: https://platform.openai.com/api-keys
# Sign up at: https://platform.openai.com/signup
# This key is used for GPT-4 powered workout planning, nutrition advice,
# real-time coaching feedback, and AI companion chat features
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# YOUTUBE DATA API CONFIGURATION
# =============================================================================

# YouTube Data API v3 Key - Required for workout video search functionality
# Get your API key from: https://console.developers.google.com/
# 1. Go to Google Cloud Console
# 2. Create a new project or select existing one
# 3. Enable YouTube Data API v3
# 4. Create credentials (API Key)
# 5. Restrict the API key to YouTube Data API v3 for security
# This key enables searching and recommending workout videos from YouTube
YOUTUBE_API_KEY=your_youtube_api_key_here

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Server Configuration (Optional - defaults will be used if not set)
# PORT=8000
# HOST=0.0.0.0

# Logging Level (Optional - defaults to INFO)
# LOG_LEVEL=INFO

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit the .env file to version control
# 4. Keep your API keys secure and don't share them

# For more information about the API setup, visit:
# - OpenAI: https://platform.openai.com/docs/quickstart
# - YouTube API: https://developers.google.com/youtube/v3/getting-started
